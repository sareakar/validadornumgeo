-- Plantilla de la migración aplicada por primera vez en
-- resermap.centraltelefonica.com.ar (2026-09-17), esquema de 2 columnas
-- agregado en dyktel.centraltelefonica.com.ar (2026-09-22). Ajustar
-- nombre de DB, tabla y columna de nombre de trunk según lo que exista
-- en cada cliente (buscar con `show tables like '%prove%'` /
-- `'%trunk%'` / `'%sip%'` en la DB `asterisk`). Ver
-- docs/PRUEBA_AGI_LXC1324.md y docs/ONBOARDING_CLIENTE.md.
--
-- Mantener siempre las dos columnas, aunque el cliente no tenga
-- troncales wholesale con código de acceso -- el script
-- agi-scripts/telvalTrunkProvider.agi asume ambas presentes en
-- cualquier cliente que lo use, para no tener que mantener variantes
-- del script por cliente.
--
-- Default '' = sin provider asignado -> el dialplan no consulta telval
-- para ese trunk, sigue directo al Dial() de siempre (fallback seguro).

ALTER TABLE id_proveedor
  ADD COLUMN telval_provider VARCHAR(40) NOT NULL DEFAULT '',
  ADD COLUMN telval_provider_prefix VARCHAR(20) NOT NULL DEFAULT '';

-- Un UPDATE por cada trunk a habilitar, usando una key de providers.py.
-- telval_provider_prefix solo hace falta si el trunk requiere anteponer
-- un código de acceso fijo (troncales wholesale, ej. IPlan/IPlanManual
-- en dyktel) -- en el resto de los casos queda vacío.
-- UPDATE id_proveedor SET telval_provider='<provider_key>' WHERE name='<NombreDelTrunk>';
-- UPDATE id_proveedor SET telval_provider='<provider_key>', telval_provider_prefix='<codigo_acceso>' WHERE name='<NombreDelTrunkWholesale>';
